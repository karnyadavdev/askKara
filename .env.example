# LLM providers. Order of the chain when calling askKara: first healthy wins,
# retriable failures (429/5xx/network) fall through to the next provider.
KARA_LLM_CHAIN=groq,openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth. Guests can ask by default; set to 1 for a private deployment where
# every caller needs an account.
KARA_AUTH_REQUIRED=0
# Set to a fixed value in production; a random secret invalidates tokens on restart.
KARA_JWT_SECRET=
KARA_JWT_TTL=86400

# YADA scraper. import = in-process library, http = call the YADA API,
# off = disable scraping (search only).
YADA_MODE=import
YADA_ROOT=
YADA_API_URL=
YADA_API_KEY=
KARA_SCRAPE_TIMEOUT=100

# Storage. SQLite for local dev; swap for
# postgresql+asyncpg://user:pass@host:5432/kara in production.
DATABASE_URL=sqlite+aiosqlite:///./kara.db
# Set to 0 once Alembic migrations own the schema.
KARA_AUTO_CREATE_TABLES=1

# Server.
KARA_HOST=127.0.0.1
KARA_PORT=4177
KARA_MAX_STEPS=8
KARA_MAX_SOURCES_CAP=10
KARA_SEARCH_ENABLED=1
