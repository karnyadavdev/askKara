# LLM providers. Comma-separated failover chain; first healthy wins,
# retriable failures (429/5xx/network) fall through to the next provider.
# NIM (NVIDIA, key at build.nvidia.com) is the default; groq/openai/etc
# stay available as fallback legs.
KARA_LLM_CHAIN=nim
NIM_API_KEY=
NIM_MODEL=z-ai/glm-5.3-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth. Guests can ask by default; set to 1 for a private deployment where
# every caller needs an account.
KARA_AUTH_REQUIRED=0
# Set to a fixed value in production; a random secret invalidates tokens on restart.
KARA_JWT_SECRET=
KARA_JWT_TTL=86400

# YADA scraper. import = in-process library, http = call the YADA API,
# off = disable scraping (search only).
YADA_MODE=import
YADA_ROOT=
YADA_API_URL=
YADA_API_KEY=
KARA_SCRAPE_TIMEOUT=100

# Storage. SQLite for local dev; swap for
# postgresql+asyncpg://user:pass@host:5432/kara in production.
DATABASE_URL=sqlite+aiosqlite:///./kara.db
# Set to 0 once Alembic migrations own the schema.
KARA_AUTO_CREATE_TABLES=1

# Server.
KARA_HOST=127.0.0.1
KARA_PORT=4177
KARA_MAX_STEPS=8
KARA_MAX_SOURCES_CAP=10
KARA_SEARCH_ENABLED=1
# Deep research: steps, source cap, and per-source summarization
# (compress each scraped page to ~1500 chars before it enters the prompt).
KARA_DEEP_MAX_STEPS=30
KARA_DEEP_MAX_SOURCES=50
KARA_SUMMARIZE=1

# Web search provider for URL discovery. tavily = agent-native search API
# (free tier at app.tavily.com); serper = real Google results
# (free credits at serper.dev); brave = independent index
# (free tier at search.brave.com/api, card on file required);
# ddgs = keyless DuckDuckGo for local dev.
KARA_SEARCH_PROVIDER=ddgs
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# Set to 1 when running behind nginx/another reverse proxy so the rate
# limiter sees real client IPs from X-Forwarded-For instead of the proxy.
# Leave 0 when uvicorn is directly exposed.
KARA_TRUST_PROXY=0
